# Copy this file to .env.deploy and fill in real values.
# .env.deploy is gitignored. Never commit it.

# Local MongoDB user created on first start. Use letters, numbers and hyphens only,
# or URL-encode special characters, because the Compose file builds the Mongo URI.
MONGO_USER=skillora
MONGO_PASSWORD=replace-with-a-long-random-password

# Keep this unchanged forever unless you want to log every user out.
JWT_SECRET=replace-with-a-long-random-string

# Your Vercel URL in production, with no trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Public port for the API on the Docker host.
HOST_PORT=5000

# Optional: without these, AI course generation and video lookup degrade gracefully.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
YOUTUBE_API_KEY=
YOUTUBE_LANGUAGE=en

# Used only by `docker compose ... run --rm api npm run seed`.
ADMIN_EMAIL=admin@skillora.local
ADMIN_PASSWORD=replace-with-a-strong-admin-password
