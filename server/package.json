{
  "name": "skillora-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "generate:starters": "node src/generateStarters.js",
    "copy-data": "node src/copyData.js",
    "build:courses": "node src/buildCourses.js",
    "cerbos": "docker compose -f ../docker-compose.yml up -d cerbos",
    "cerbos:stop": "docker compose -f ../docker-compose.yml stop cerbos",
    "test:policies": "docker compose -f ../docker-compose.yml run --rm cerbos compile /policies",
    "reset-admin": "node src/resetAdmin.js"
  },
  "dependencies": {
    "@cerbos/http": "^0.30.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.1.2"
  }
}
