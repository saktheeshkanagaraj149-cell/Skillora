# Leave MONGO_URI empty in development to use a built-in local MongoDB (data kept in server/.data)
# For production use MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skillora
MONGO_URI=

JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Free key: https://aistudio.google.com/apikey  (without it, the generator returns a simple template path)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Free key for embedded lesson videos: console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
# (~100 lesson lookups per day on the free quota; without it lessons keep YouTube search links)
YOUTUBE_API_KEY=
YOUTUBE_LANGUAGE=en

# First admin account created by `npm run seed`
ADMIN_EMAIL=admin@skillora.local
ADMIN_PASSWORD=Admin@12345
